# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Database
# Local dev (uvicorn) connects to the dockerized PostgreSQL: start it with
# `docker compose up -d db` (published on 127.0.0.1:5432 only). Credentials match the
# POSTGRES_* defaults in docker-compose.yml. When running the full stack via docker
# compose, the backend service gets its own DATABASE_URL injected (this value is unused).
DATABASE_URL=postgresql+psycopg2://bulten:changeme@localhost:5432/bulten
CHECKPOINTS_DB=checkpoints.db

# Application Settings
APP_NAME=News Summarizer
APP_VERSION=1.0.0
DEBUG=True

# RSS Feed Configuration
DEFAULT_FEED_URL=https://rss.dw.com/atom/rss-de-all
FEED_REFRESH_INTERVAL=1800  # seconds (30 minutes)

# LangGraph workflow recursion limit — must cover the max number of new
# articles processed in a single feed refresh (default LangGraph limit is 25).
GRAPH_RECURSION_LIMIT=100

# Scraping Configuration
SCRAPING_ENABLED=True
SCRAPING_DELAY=1.0  # seconds between requests
MAX_RETRIES=3

# OpenAI Configuration
DEFAULT_MODEL=gpt-4o-mini
DETAILED_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60.0  # tek bir OpenAI isteği için üst sınır (saniye)
MAX_TOKENS_INPUT=40000
MAX_TOKENS_OUTPUT_BRIEF=150
MAX_TOKENS_OUTPUT_STANDARD=300
MAX_TOKENS_OUTPUT_DETAILED=1000

# Cost Management
DAILY_COST_LIMIT=5.0  # USD
MONTHLY_COST_LIMIT=100.0  # USD

# Bulletin (Word report) generation
BULLETIN_CLASSIFICATION_BATCH_SIZE=15  # articles per LLM classification call
BULLETIN_MAX_ARTICLES=400  # hard cap on articles selected for a single report
BULLETIN_STORAGE_DIR=./bulletin_reports  # persisted .docx reports, for re-download

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication (REQUIRED in production — must not be left at the default)
JWT_SECRET_KEY=change-me-in-production-use-32-char-minimum-secret-key

# Initial admin account — set both to seed the first admin user on first startup.
# If either is left unset, no admin account is created automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=
