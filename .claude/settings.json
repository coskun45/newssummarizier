{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/hooks/check_features_json.py",
            "timeout": 30,
            "statusMessage": "features.json kontrol ediliyor..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/hooks/protect_secrets.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python .claude/hooks/lint_on_edit.py",
            "timeout": 90,
            "statusMessage": "Lint çalışıyor..."
          }
        ]
      }
    ]
  }
}
