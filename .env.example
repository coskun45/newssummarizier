# ─────────────────────────────────────────────────────────────────────────────
# TEK yapılandırma dosyası (repo kökü). Kopyala ve gerçek değerleri doldur:
#
#   cp .env.example .env
#
# Kim okur:
#   - `docker compose`       → ${POSTGRES_*} substitution + backend container'ının env_file'ı
#   - yerel `uvicorn`        → backend/app/core/config.py bu dosyayı (repo kökünden) okurken bulur
#   - deploy.sh / deploy.yml → sunucuda ilk kurulumda bu dosyadan `.env` üretir
#
# Gerçek `.env` ASLA commit'lenmez (.gitignore). Buraya gerçek key/şifre yazma.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# PostgreSQL (docker-compose.yml içindeki `db` servisi)
POSTGRES_USER=bulten
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bulten

# Yerel `uvicorn` için bağlantı: `docker compose up -d db` (127.0.0.1:5432'ye açılır).
# Kullanıcı/şifre/DB adı yukarıdaki POSTGRES_* ile AYNI olmalı.
# Docker'daki backend container'ında bu değer docker-compose.yml tarafından `db` host'una çevrilir.
DATABASE_URL=postgresql+psycopg2://bulten:changeme@localhost:5432/bulten

# Application Settings
APP_NAME=News Summarizer
# Deploy'da CI (ci-cd.yml → scripts/next_version.py) bu değeri git tag'inden ezer: major = features.json'daki en yüksek vN.
APP_VERSION=2.0.0
DEBUG=True

# RSS Feed Configuration
DEFAULT_FEED_URL=https://rss.dw.com/atom/rss-de-all
FEED_REFRESH_INTERVAL=1800  # seconds (30 minutes)

# LangGraph workflow recursion limit — must cover the max number of new
# articles processed in a single feed refresh (default LangGraph limit is 25).
GRAPH_RECURSION_LIMIT=100

# Scraping Configuration
SCRAPING_ENABLED=True
SCRAPING_DELAY=1.0  # seconds between requests
MAX_RETRIES=3

# OpenAI Configuration
DEFAULT_MODEL=gpt-4o-mini
DETAILED_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60.0  # tek bir OpenAI isteği için üst sınır (saniye)
MAX_TOKENS_INPUT=40000
MAX_TOKENS_OUTPUT_BRIEF=1500
MAX_TOKENS_OUTPUT_STANDARD=3000
MAX_TOKENS_OUTPUT_DETAILED=10000

# Cost Management
DAILY_COST_LIMIT=10.0  # USD
MONTHLY_COST_LIMIT=100.0  # USD

# Bulletin (Word report) generation
BULLETIN_CLASSIFICATION_BATCH_SIZE=15  # articles per LLM classification call
BULLETIN_MAX_ARTICLES=400  # hard cap on articles selected for a single report
BULLETIN_STORAGE_DIR=./bulletin_reports  # persisted .docx reports, for re-download

# CORS — comma-separated. Sunucuda deploy bunu http://<sunucu-ip> yapar.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# JWT Authentication (REQUIRED in production — must not be left at the default)
JWT_SECRET_KEY=change-me-in-production-use-32-char-minimum-secret-key

# Initial admin account — set both to seed the first admin user on first startup.
# If either is left unset, no admin account is created automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local dev only: skip the login page and open the app as the admin user (ADMIN_EMAIL, else the first admin).
# Works only together with DEBUG=True — Docker forces DEBUG=false, so it is always off on the server.
DEV_AUTO_LOGIN=false
