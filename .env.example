# Repo-root env file, read by `docker compose` for ${VAR} substitution in
# docker-compose.yml (separate from backend/.env, which is injected into the
# backend container itself). Copy to `.env` and fill in real values:
#
#   cp .env.example .env
#
# Never commit the real `.env` — it's already covered by .gitignore's bare `.env` pattern.

# PostgreSQL (the `db` service in docker-compose.yml)
POSTGRES_USER=bulten
POSTGRES_PASSWORD=change-me-use-a-strong-secret-in-production
POSTGRES_DB=bulten

# JWT signing key — same variable docker-compose.yml already falls back on;
# set it here instead of exporting it in the shell before `docker compose up`.
JWT_SECRET_KEY=change-me-use-a-strong-secret-in-production
